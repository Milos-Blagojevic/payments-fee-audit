{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/payments-fee-audit/contract.schema.json",
  "title": "Fee contract version",
  "description": "One version of a provider or client fee contract (docs/data-contract.md section 4).",
  "type": "object",
  "required": [
    "contract_id",
    "party",
    "counterparty",
    "name",
    "version",
    "effective_from",
    "currency",
    "timezone",
    "rounding",
    "dispute_window_days",
    "terms"
  ],
  "properties": {
    "contract_id": {
      "$ref": "#/$defs/text"
    },
    "party": {
      "enum": [
        "provider",
        "client"
      ]
    },
    "counterparty": {
      "$ref": "#/$defs/text"
    },
    "name": {
      "$ref": "#/$defs/text"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "effective_from": {
      "$ref": "#/$defs/date"
    },
    "effective_to": {
      "anyOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "currency": {
      "enum": [
        "EUR"
      ]
    },
    "timezone": {
      "$ref": "#/$defs/text"
    },
    "rounding": {
      "type": "object",
      "required": [
        "mode",
        "level"
      ],
      "properties": {
        "mode": {
          "enum": [
            "half_up",
            "half_even"
          ]
        },
        "level": {
          "enum": [
            "transaction",
            "invoice_line"
          ]
        }
      },
      "additionalProperties": false
    },
    "dispute_window_days": {
      "type": "integer",
      "minimum": 0
    },
    "terms": {
      "type": "array",
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "party": {
            "const": "provider"
          }
        },
        "required": [
          "party"
        ]
      },
      "then": {
        "properties": {
          "terms": {
            "items": {
              "$ref": "#/$defs/provider_term"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "party": {
            "const": "client"
          }
        },
        "required": [
          "party"
        ]
      },
      "then": {
        "properties": {
          "terms": {
            "items": {
              "$ref": "#/$defs/client_term"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "nonneg_int": {
      "type": "integer",
      "minimum": 0
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "segment_price": {
      "type": "object",
      "required": [
        "bps",
        "fixed_minor"
      ],
      "properties": {
        "bps": {
          "$ref": "#/$defs/nonneg_int"
        },
        "fixed_minor": {
          "$ref": "#/$defs/nonneg_int"
        }
      },
      "additionalProperties": false
    },
    "segments": {
      "type": "object",
      "required": [
        "eea_consumer",
        "other"
      ],
      "properties": {
        "eea_consumer": {
          "$ref": "#/$defs/segment_price"
        },
        "other": {
          "$ref": "#/$defs/segment_price"
        }
      },
      "additionalProperties": false
    },
    "provider_term": {
      "type": "object",
      "required": [
        "clause",
        "kind",
        "title"
      ],
      "properties": {
        "kind": {
          "enum": [
            "pass_through",
            "markup_bps_tiered",
            "per_transaction_fixed",
            "blended_rate",
            "volume_discount",
            "refund",
            "chargeback_fee",
            "monthly_minimum",
            "payout_fee",
            "fx_spread_cap"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "pass_through"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/kind_pass_through"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "markup_bps_tiered"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/kind_markup_bps_tiered"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "per_transaction_fixed"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/kind_per_transaction_fixed"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "blended_rate"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/kind_blended_rate"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "volume_discount"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/kind_volume_discount"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "refund"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/kind_refund"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "chargeback_fee"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/kind_chargeback_fee"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "monthly_minimum"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/kind_monthly_minimum"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "payout_fee"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/kind_payout_fee"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fx_spread_cap"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/kind_fx_spread_cap"
          }
        }
      ]
    },
    "client_term": {
      "type": "object",
      "required": [
        "clause",
        "kind",
        "title"
      ],
      "properties": {
        "kind": {
          "enum": [
            "payment_fee_by_segment",
            "payout_fee_by_rail",
            "fx_markup",
            "platform_fee",
            "volume_discount_tiered",
            "promo_discount"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "payment_fee_by_segment"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/kind_payment_fee_by_segment"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "payout_fee_by_rail"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/kind_payout_fee_by_rail"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fx_markup"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/kind_fx_markup"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "platform_fee"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/kind_platform_fee"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "volume_discount_tiered"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/kind_volume_discount_tiered"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "promo_discount"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/kind_promo_discount"
          }
        }
      ]
    },
    "kind_pass_through": {
      "type": "object",
      "required": [
        "clause",
        "kind",
        "title",
        "components",
        "reference"
      ],
      "properties": {
        "clause": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "const": "pass_through"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "components": {
          "type": "array",
          "prefixItems": [
            {
              "const": "interchange"
            },
            {
              "const": "scheme_fee"
            }
          ],
          "items": false,
          "minItems": 2
        },
        "reference": {
          "$ref": "#/$defs/text"
        }
      },
      "additionalProperties": false
    },
    "kind_markup_bps_tiered": {
      "type": "object",
      "required": [
        "clause",
        "kind",
        "title",
        "basis",
        "tiering",
        "tiers"
      ],
      "properties": {
        "clause": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "const": "markup_bps_tiered"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "component": {
          "const": "markup"
        },
        "basis": {
          "const": "monthly_processed_volume"
        },
        "tiering": {
          "const": "retroactive"
        },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "up_to_minor",
              "bps"
            ],
            "properties": {
              "up_to_minor": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "bps": {
                "$ref": "#/$defs/nonneg_int"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "kind_per_transaction_fixed": {
      "type": "object",
      "required": [
        "clause",
        "kind",
        "title",
        "amount_minor"
      ],
      "properties": {
        "clause": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "const": "per_transaction_fixed"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "component": {
          "const": "fixed_fee"
        },
        "amount_minor": {
          "$ref": "#/$defs/nonneg_int"
        }
      },
      "additionalProperties": false
    },
    "kind_blended_rate": {
      "type": "object",
      "required": [
        "clause",
        "kind",
        "title",
        "segments",
        "failed_attempts"
      ],
      "properties": {
        "clause": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "const": "blended_rate"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "component": {
          "const": "transaction_fee"
        },
        "segments": {
          "$ref": "#/$defs/segments"
        },
        "failed_attempts": {
          "const": "no_fee"
        }
      },
      "additionalProperties": false
    },
    "kind_volume_discount": {
      "type": "object",
      "required": [
        "clause",
        "kind",
        "title",
        "segment",
        "basis",
        "tiering",
        "settlement",
        "tiers"
      ],
      "properties": {
        "clause": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "const": "volume_discount"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "component": {
          "const": "volume_adjustment"
        },
        "segment": {
          "const": "eea_consumer"
        },
        "basis": {
          "const": "monthly_segment_volume"
        },
        "tiering": {
          "const": "marginal"
        },
        "settlement": {
          "const": "monthly_adjustment"
        },
        "tiers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "up_to_minor",
              "bps"
            ],
            "properties": {
              "up_to_minor": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "bps": {
                "$ref": "#/$defs/nonneg_int"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "kind_refund": {
      "type": "object",
      "required": [
        "clause",
        "kind",
        "title",
        "fee_minor",
        "credit_original_markup"
      ],
      "properties": {
        "clause": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "const": "refund"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "fee_minor": {
          "$ref": "#/$defs/nonneg_int"
        },
        "credit_original_markup": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "kind_chargeback_fee": {
      "type": "object",
      "required": [
        "clause",
        "kind",
        "title",
        "amount_minor"
      ],
      "properties": {
        "clause": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "const": "chargeback_fee"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "component": {
          "const": "chargeback_fee"
        },
        "amount_minor": {
          "$ref": "#/$defs/nonneg_int"
        }
      },
      "additionalProperties": false
    },
    "kind_monthly_minimum": {
      "type": "object",
      "required": [
        "clause",
        "kind",
        "title",
        "applies_to",
        "amount_minor"
      ],
      "properties": {
        "clause": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "const": "monthly_minimum"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "component": {
          "const": "monthly_minimum"
        },
        "applies_to": {
          "const": "markup"
        },
        "amount_minor": {
          "$ref": "#/$defs/nonneg_int"
        }
      },
      "additionalProperties": false
    },
    "kind_payout_fee": {
      "type": "object",
      "required": [
        "clause",
        "kind",
        "title",
        "rail"
      ],
      "properties": {
        "clause": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "const": "payout_fee"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "component": {
          "const": "payout_fee"
        },
        "rail": {
          "enum": [
            "sepa",
            "faster_payments",
            "swift",
            "elixir"
          ]
        },
        "fixed_minor": {
          "$ref": "#/$defs/nonneg_int"
        },
        "bps": {
          "$ref": "#/$defs/nonneg_int"
        },
        "min_minor": {
          "$ref": "#/$defs/nonneg_int"
        },
        "cap_minor": {
          "$ref": "#/$defs/nonneg_int"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "fixed_minor"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "bps"
                ]
              },
              {
                "required": [
                  "min_minor"
                ]
              },
              {
                "required": [
                  "cap_minor"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "bps",
            "min_minor",
            "cap_minor"
          ],
          "not": {
            "required": [
              "fixed_minor"
            ]
          }
        }
      ]
    },
    "kind_fx_spread_cap": {
      "type": "object",
      "required": [
        "clause",
        "kind",
        "title",
        "benchmark",
        "rate_time",
        "caps_bps"
      ],
      "properties": {
        "clause": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "const": "fx_spread_cap"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "component": {
          "const": "fx_conversion"
        },
        "benchmark": {
          "const": "fx_mid_hourly"
        },
        "rate_time": {
          "const": "execution_hour"
        },
        "caps_bps": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "GBP",
              "USD",
              "CHF",
              "PLN"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/nonneg_int"
          }
        }
      },
      "additionalProperties": false
    },
    "kind_payment_fee_by_segment": {
      "type": "object",
      "required": [
        "clause",
        "kind",
        "title",
        "segments"
      ],
      "properties": {
        "clause": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "const": "payment_fee_by_segment"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "component": {
          "const": "payment_fees"
        },
        "segments": {
          "$ref": "#/$defs/segments"
        }
      },
      "additionalProperties": false
    },
    "kind_payout_fee_by_rail": {
      "type": "object",
      "required": [
        "clause",
        "kind",
        "title",
        "rails"
      ],
      "properties": {
        "clause": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "const": "payout_fee_by_rail"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "rails": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "sepa",
              "faster_payments",
              "swift",
              "elixir"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "fixed_minor"
            ],
            "properties": {
              "fixed_minor": {
                "$ref": "#/$defs/nonneg_int"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "kind_fx_markup": {
      "type": "object",
      "required": [
        "clause",
        "kind",
        "title",
        "bps"
      ],
      "properties": {
        "clause": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "const": "fx_markup"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "component": {
          "const": "fx_markup"
        },
        "bps": {
          "$ref": "#/$defs/nonneg_int"
        }
      },
      "additionalProperties": false
    },
    "kind_platform_fee": {
      "type": "object",
      "required": [
        "clause",
        "kind",
        "title",
        "amount_minor"
      ],
      "properties": {
        "clause": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "const": "platform_fee"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "component": {
          "const": "platform_fee"
        },
        "amount_minor": {
          "$ref": "#/$defs/nonneg_int"
        }
      },
      "additionalProperties": false
    },
    "kind_volume_discount_tiered": {
      "type": "object",
      "required": [
        "clause",
        "kind",
        "title",
        "basis",
        "tiering",
        "tiers"
      ],
      "properties": {
        "clause": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "const": "volume_discount_tiered"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "component": {
          "const": "volume_discount"
        },
        "basis": {
          "const": "monthly_processed_volume"
        },
        "tiering": {
          "const": "retroactive"
        },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "up_to_minor",
              "discount_pct"
            ],
            "properties": {
              "up_to_minor": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "discount_pct": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "kind_promo_discount": {
      "type": "object",
      "required": [
        "clause",
        "kind",
        "title",
        "discount_pct",
        "valid_until"
      ],
      "properties": {
        "clause": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "const": "promo_discount"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "component": {
          "const": "promo_discount"
        },
        "discount_pct": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "valid_until": {
          "$ref": "#/$defs/date"
        }
      },
      "additionalProperties": false
    }
  }
}
